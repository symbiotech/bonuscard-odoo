# Copy this file to .env and fill in your local values.
BONUSCARD_TEST_API_BASE_URL=https://test.bonuscard.com/api/
BONUSCARD_TEST_USERNAME=
BONUSCARD_TEST_PASSWORD=
BONUSCARD_TEST_CULTURE=en-GB
BONUSCARD_TEST_CONSUMER=
# Optional: barcode/EAN of an Odoo product that is NOT on the Bonuscard API (ValidatePurchase should reject it)
BONUSCARD_TEST_NON_BONUSCARD_EAN=0000000000001
# Barcode/EAN of a product that IS on the Bonuscard API (used to verify the customer is not locked)
BONUSCARD_TEST_BONUSCARD_EAN=7350015761520
