flowchart LR
    subgraph POS Frontend
        A[Select Customer in POS]
        R[Register with Bonuscard\npartner list menu]
        B[Start Payment]
        C[Payment Validation]
        D[Payment Success]
        E[Cancel / Back / POS Close]
    end

    subgraph Odoo Backend
        F[res.partner.get_bonuscard_status_for_pos]
        Q[res.partner.action_bulk_prefetch_bonuscard_status]
        S[ir.cron / manual bulk prefetch]
        O[res.partner.action_register_to_bonuscard]
        G[bonuscard.api.service.validate_purchase_for_pos]
        H[bonuscard.api.service.finalize_purchase_for_pos]
        I[bonuscard.api.service.cancel_purchase_for_pos]
        J[bonuscard.connector.instance\nBonuscard API credentials]
    end

    subgraph Bonuscard API
        K[SearchCustomers]
        P[RegisterCustomer]
        L[ValidatePurchase]
        M[FinalizePurchase]
        N[CancelPurchase]
    end

    A -->|setPartnerToCurrentOrder| F
    F -->|search terms: phone/email/name| K
    K -->|match result| F
    F -->|status/recruitment_code| A
    A -->|status=linked: auto-validate| G

    S -->|batch prefetch (phone→email→optional name)| Q
    Q -->|search terms: phone/email/name| K
    K -->|match result| Q

    R -->|not_found partner| O
    O -->|re-check then register by phone| P
    P -->|recruitmentCode| O
    O -->|refresh partner status| A

    B -->|final guard before payment| G
    G -->|checkoutItems + customerIdentifier| L
    L -->|transactionIdentifier + discounts| G
    G -->|no eligible lines: cancel pending transaction| I
    G -->|transactionIdentifier + discounts (POS applies discounts to order)| B

    C -->|afterOrderValidation| H
    H -->|transactionIdentifier + checkoutItems| M
    M -->|commit purchase| H
    H -->|finalize success: clear bonuscard state| C
    H -->|finalize failed after retry: cancel fallback| I
    H -->|finalize and cancel fallback failed: sticky warning| C
    C -->|no checkoutItems: cancel pending transaction| I
    I -->|release success: clear bonuscard state| C
    I -->|release failed after payment: sticky warning| C

    E -->|cancel pending transaction| I
    I -->|transactionIdentifier| N
    N -->|cancel purchase| I
    I -->|clear order bonuscard state| E

    J -->|used by search/status sync| F
    J -->|used by bulk prefetch| Q
    J -->|used by register| O
    J -->|used by validate/finalize/cancel| G
    J -->|used by validate/finalize/cancel| H
    J -->|used by validate/finalize/cancel| I
