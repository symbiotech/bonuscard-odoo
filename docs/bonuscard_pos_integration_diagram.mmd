flowchart LR
    subgraph POS Frontend
        PL[Customer list search\nrecruitment code + Enter fallback]
        A[Select Customer in POS]
        R[Register with Bonuscard\npartner list menu]
        AD[Actions Bonuscard button\nactivate discount code]
        PC[Product grid ProductCard\nBonuscard mark for in_catalog]
        PI[Long-press product info\ncatalog status badge]
        B[Start Payment]
        C[Payment Validation]
        D[Payment Success]
        E[Cancel / Back / POS Close]
    end

    subgraph Odoo Backend
        BS[res.partner.bonuscard_pos_search]
        F[res.partner.get_bonuscard_status_for_pos]
        IMP[res.partner.import_partner_from_bonuscard_for_pos]
        Q[res.partner.action_bulk_prefetch_bonuscard_status]
        S[ir.cron / manual bulk prefetch]
        O[res.partner.action_register_to_bonuscard]
        ACT[bonuscard.api.service.activate_discount_code_for_pos]
        G[bonuscard.api.service.validate_purchase_for_pos]
        H[bonuscard.api.service.finalize_purchase_for_pos]
        I[bonuscard.api.service.cancel_purchase_for_pos]
        J[bonuscard.connector.instance\nBonuscard API credentials]
        T[bonuscard.api.service.probe_product_catalog_status]
        U[product.product / product.template\ncatalog probe actions]
    end

    subgraph Bonuscard API
        K[SearchCustomers]
        P[RegisterCustomer]
        ADC[ActivateDiscountCode]
        L[ValidatePurchase]
        M[FinalizePurchase]
        N[CancelPurchase]
    end

    subgraph Catalog Probe
        V[Daily cron / Run Catalog Probe]
        W[Check Bonuscard Catalog\nproduct list/form action]
    end

    PL -->|client filter + Enter/load more| BS
    BS -->|matching partners| PL
    PL -->|select partner| A
    A -->|setPartnerToCurrentOrder| F
    PL -->|local Odoo search empty| IMP
    IMP -->|SearchCustomers query| K
    K -->|recruitment code, phone (national/E.164), or email match| IMP
    IMP -->|create/link partner + load in POS| PL
    PL -->|select imported partner| A
    F -->|search terms phone email name| K
    K -->|match result| F
    F -->|status/recruitment_code| A
    A -->|status linked auto-validate| G

    S -->|batch prefetch phone email optional name| Q
    Q -->|search terms phone email name| K
    K -->|match result| Q

    R -->|not_found partner| O
    O -->|re-check then register by phone| P
    P -->|recruitmentCode| O
    O -->|refresh partner status| A

    AD -->|linked partner + code| ACT
    ACT -->|customerIdentifier + code| ADC
    ADC -->|success or errorCode 5| ACT
    ACT -->|success re-validate| G
    ACT -->|errorCode 5 stash pending codes then re-validate| G

    B -->|final guard before payment| G
    G -->|checkoutItems + customerIdentifier + pending codes| L
    L -->|transactionIdentifier + discounts| G
    G -->|success keeps pending codes for pay/Finalize| G
    G -->|no catalog lines cancel pending transaction| I
    G -->|transactionIdentifier + discounts POS applies discounts| B

    C -->|preSyncAllOrders before sync| H
    H -->|transactionIdentifier + checkoutItems + remaining pending codes| M
    M -->|commit purchase| H
    H -->|finalize success persist audit on pos.order| C
    H -->|finalize failed cancel fallback preserves paid lines| I
    H -->|finalize and cancel fallback failed sticky warning| C
    C -->|no checkoutItems cancel pending transaction| I
    I -->|release success persist audit on pos.order| C
    I -->|release failed sticky warning| C

    E -->|cancel pending transaction| I
    I -->|transactionIdentifier| N
    N -->|cancel purchase| I
    I -->|persist audit on pos.order| E

    J -->|used by search/status sync| F
    J -->|used by POS customer import| IMP
    J -->|used by bulk prefetch| Q
    J -->|used by register| O
    J -->|used by activate discount| ACT
    J -->|used by validate/finalize/cancel| G
    J -->|used by validate/finalize/cancel| H
    J -->|used by validate/finalize/cancel| I

    V -->|not_set products batch| U
    W -->|selected products| U
    U -->|bulk or single probe| T
    T -->|ValidatePurchase per product anchor + probe EAN| L
    L -->|probe EAN enriched in checkoutItems in catalog| T
    L -->|no enriched probe EAN or no valid products not in catalog| T
    L -->|no transactionIdentifier other message unchanged| T
    T -->|auto-cancel open transaction before next product| I
    I -->|transactionIdentifier| N
    J -->|probe customer + credentials| T
    U -->|in_catalog status loaded in POS| PC
    U -->|catalog status for single-variant products| PI
