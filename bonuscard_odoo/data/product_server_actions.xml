<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Product Variants list: shown when Product Variants are enabled. -->
    <record id="action_bonuscard_mark_products_in_catalog" model="ir.actions.server">
        <field name="name">Mark as Bonuscard Catalog</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('bonuscard_odoo.bonuscard_odoo_group_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_bonuscard_mark_in_catalog()</field>
    </record>

    <!-- Products (templates) list: intended for no-variant setups; gated by Bonuscard group (model rejects variant users). -->
    <record id="action_bonuscard_mark_templates_in_catalog" model="ir.actions.server">
        <field name="name">Mark as Bonuscard Catalog</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('bonuscard_odoo.bonuscard_odoo_group_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_bonuscard_mark_in_catalog()</field>
    </record>

    <record id="action_bonuscard_mark_products_not_in_catalog" model="ir.actions.server">
        <field name="name">Mark as Not in Bonuscard Catalog</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('bonuscard_odoo.bonuscard_odoo_group_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_bonuscard_mark_not_in_catalog()</field>
    </record>

    <!-- Products (templates) list: intended for no-variant setups; gated by Bonuscard group (model rejects variant users). -->
    <record id="action_bonuscard_mark_templates_not_in_catalog" model="ir.actions.server">
        <field name="name">Mark as Not in Bonuscard Catalog</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('bonuscard_odoo.bonuscard_odoo_group_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_bonuscard_mark_not_in_catalog()</field>
    </record>

    <record id="action_bonuscard_reset_products_catalog_status" model="ir.actions.server">
        <field name="name">Reset Bonuscard Catalog Status</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('bonuscard_odoo.bonuscard_odoo_group_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_bonuscard_reset_catalog_status()</field>
    </record>

    <!-- Products (templates) list: intended for no-variant setups; gated by Bonuscard group (model rejects variant users). -->
    <record id="action_bonuscard_reset_templates_catalog_status" model="ir.actions.server">
        <field name="name">Reset Bonuscard Catalog Status</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('bonuscard_odoo.bonuscard_odoo_group_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_bonuscard_reset_catalog_status()</field>
    </record>

</odoo>
