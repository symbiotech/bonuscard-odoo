<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="bonuscard_odoo.PartnerLineExtension" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//td[hasclass('edit-partner-button-cell')]//DropdownItem[last()]" position="after">
            <DropdownItem t-if="props.partner.bonuscard_status == 'not_found'" onSelected="() => this.bonuscardService.registerPartnerToBonuscard(props.partner, this.pos)">
                Register with Bonuscard
            </DropdownItem>
        </xpath>
    </t>

</templates>
