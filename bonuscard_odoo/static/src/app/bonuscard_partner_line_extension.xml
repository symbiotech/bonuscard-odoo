<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="bonuscard_odoo.PartnerLineExtension" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//t[.//DropdownItem and contains(., 'All Orders')]" position="inside">
            <DropdownItem t-if="props.partner.bonuscard_status == 'not_found'" onSelected="() => props.onClickRegisterBonuscard(props.partner)">
                <t t-esc="_t('Register with Bonuscard')" />
            </DropdownItem>
        </xpath>
    </t>

</templates>
