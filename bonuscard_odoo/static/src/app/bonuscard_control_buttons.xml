<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="bonuscard_odoo.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath
            expr="//t[@t-if='props.showRemainingButtons']/div/button[hasclass('o_pricelist_button')]"
            position="before">
            <button t-att-class="buttonClass" t-on-click="() => this.clickBonuscardCode()">
                <i class="fa fa-barcode me-1"/>Bonuscard
            </button>
        </xpath>
    </t>

</templates>
