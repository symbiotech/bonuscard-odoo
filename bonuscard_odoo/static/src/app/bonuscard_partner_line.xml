<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="bonuscard_odoo.PartnerLineMobile" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//div[@class='d-flex justify-content-between align-items-center p-1']/div" position="inside">
            <div class="mt-1" t-if="props.partner.bonuscard_status == 'linked'">
                <span class="badge text-bg-success">Bonuscard</span>
            </div>
            <div class="mt-1" t-if="props.partner.bonuscard_status == 'not_found'">
                <span class="badge text-bg-secondary">No Bonuscard</span>
            </div>
            <div class="mt-1" t-if="props.partner.bonuscard_status == 'ambiguous'">
                <span class="badge text-bg-warning">Multiple Matches</span>
            </div>
        </xpath>
        <xpath expr="//td[@class='text-break w-25']" position="inside">
            <div class="mt-1" t-if="props.partner.bonuscard_status == 'linked'">
                <span class="badge text-bg-success">Bonuscard</span>
            </div>
            <div class="mt-1" t-if="props.partner.bonuscard_status == 'not_found'">
                <span class="badge text-bg-secondary">No Bonuscard</span>
            </div>
            <div class="mt-1" t-if="props.partner.bonuscard_status == 'ambiguous'">
                <span class="badge text-bg-warning">Multiple Matches</span>
            </div>
        </xpath>
    </t>

</templates>
