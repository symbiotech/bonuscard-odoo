<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_partner_form_bonuscard" model="ir.ui.view">
        <field name="name">res.partner.form.bonuscard</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_refresh_bonuscard_status" icon="fa-id-card-o" groups="base.group_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Bonuscard</span>
                        <span class="o_stat_text" invisible="bonuscard_status != 'linked'">Linked</span>
                        <span class="o_stat_text" invisible="bonuscard_status != 'not_found'">Not Found</span>
                        <span class="o_stat_text" invisible="bonuscard_status != 'ambiguous'">Multiple</span>
                        <span class="o_stat_text" invisible="bonuscard_status != 'error'">Error</span>
                        <span class="o_stat_text" invisible="bonuscard_status != 'not_checked'">Check</span>
                    </div>
                </button>
            </div>
            <xpath expr="//sheet/group" position="after">
                <group string="Bonuscard" groups="base.group_user">
                    <group>
                        <field name="bonuscard_status" widget="badge" readonly="1"/>
                        <field name="bonuscard_recruitment_code" readonly="1"/>
                        <field name="bonuscard_internal_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="bonuscard_last_synced_at" readonly="1"/>
                        <field name="bonuscard_last_lookup_note" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                    <group col="4">
                        <button name="action_refresh_bonuscard_status" string="Check Bonuscard" type="object" class="btn-primary"/>
                        <button name="action_clear_bonuscard_link" string="Reset Bonuscard Status" type="object" invisible="bonuscard_status == 'not_checked'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
