<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="bonuscard_odoo_instance_view_form" model="ir.ui.view">
        <field name="name">bonuscard.connector.instance.view.form</field>
        <field name="model">bonuscard.connector.instance</field>
        <field name="arch" type="xml">
            <form string="Bonuscard Connection">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary"/>
                    <button name="action_run_bulk_partner_prefetch" string="Run Bulk Prefetch" type="object" groups="bonuscard_odoo.bonuscard_odoo_group_manager" help="Look up Bonuscard status for partners that have never been scanned (same scope as the daily scheduled job). Processes up to the batch size below."/>
                    <button name="action_run_bulk_partner_prefetch_force_refresh" string="Refresh Bulk Prefetch" type="object" groups="bonuscard_odoo.bonuscard_odoo_group_manager" help="Re-check partners already scanned whose last lookup is older than the TTL below. Skips partners checked recently to limit API calls."/>
                    <button name="action_run_catalog_probe" string="Run Catalog Probe" type="object" groups="bonuscard_odoo.bonuscard_odoo_group_manager" help="Probe Bonuscard catalog status for products that have never been scanned (same scope as the daily catalog probe cron)."/>
                    <field name="connection_status" widget="statusbar" statusbar_visible="unknown,ok,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Production Bonuscard"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_current"/>
                            <field name="active"/>
                            <field name="company_id"/>
                            <field name="api_base_url"/>
                        </group>
                        <group>
                            <field name="api_username"/>
                            <field name="api_password" password="True"/>
                            <field name="api_culture"/>
                            <field name="request_timeout"/>
                            <field name="last_test_at"/>
                        </group>
                    </group>
                    <group string="Bulk Prefetch">
                        <div colspan="2" class="text-muted">
                            Header buttons look up Bonuscard customer links (phone → email → optional name).
                            <strong>Run</strong> processes only never-scanned partners (same as the daily cron).
                            <strong>Refresh</strong> re-checks partners older than the TTL.
                            Processing runs immediately and may take a moment for large batches.
                        </div>
                        <group>
                            <field name="bulk_partner_prefetch_active"/>
                            <field name="bulk_partner_prefetch_enable_name_fallback"/>
                        </group>
                        <group>
                            <field name="bulk_partner_prefetch_ttl_hours"/>
                            <field name="bulk_partner_prefetch_batch_size"/>
                        </group>
                    </group>
                    <group string="Catalog Probe">
                        <div colspan="2" class="text-muted">
                            Probes product catalog status by calling
                            <strong>ValidatePurchase</strong> with the dedicated test
                            customer below. Unknown products are detected when Bonuscard
                            returns no transaction identifier. Products are processed one
                            by one. The daily cron only scans products with catalog
                            status <strong>Not Set</strong>.
                        </div>
                        <group>
                            <field name="catalog_probe_active"/>
                            <field name="catalog_probe_customer_identifier"/>
                        </group>
                        <group>
                            <field name="catalog_probe_price"/>
                            <field name="catalog_probe_batch_size"/>
                        </group>
                    </group>
                    <group string="Diagnostics">
                        <field name="last_error" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bonuscard_odoo_instance_view_list" model="ir.ui.view">
        <field name="name">bonuscard.connector.instance.view.list</field>
        <field name="model">bonuscard.connector.instance</field>
        <field name="arch" type="xml">
            <list string="Bonuscard Connections">
                <field name="name"/>
                <field name="company_id"/>
                <field name="is_current"/>
                <field name="connection_status"/>
                <field name="last_test_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="bonuscard_odoo_instance_view_search" model="ir.ui.view">
        <field name="name">bonuscard.connector.instance.view.search</field>
        <field name="model">bonuscard.connector.instance</field>
        <field name="arch" type="xml">
            <search string="Search Bonuscard Connections">
                <field name="name"/>
                <field name="company_id"/>
                <filter string="Current" name="current" domain="[('is_current', '=', True)]"/>
                <filter string="OK" name="ok" domain="[('connection_status', '=', 'ok')]"/>
                <filter string="Error" name="error" domain="[('connection_status', '=', 'error')]"/>
                <separator/>
                <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                <filter string="Status" name="group_by_status" context="{'group_by': 'connection_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_bonuscard_odoo_instance" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">bonuscard.connector.instance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bonuscard_odoo_instance_view_search"/>
    </record>

</odoo>
