<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Intended for Bonuscard users on Inventory > Products (no-variant setups). -->
    <record id="view_product_template_tree_bonuscard" model="ir.ui.view">
        <field name="name">product.template.tree.bonuscard</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field
                    name="bonuscard_catalog_status"
                    widget="badge"
                    optional="hide"
                    groups="bonuscard_odoo.bonuscard_odoo_group_user"
                    decoration-success="bonuscard_catalog_status == 'in_catalog'"
                    decoration-danger="bonuscard_catalog_status == 'not_in_catalog'"
                    decoration-muted="bonuscard_catalog_status == 'not_set'"
                />
                <field name="bonuscard_catalog_updated_at" optional="hide" groups="bonuscard_odoo.bonuscard_odoo_group_user"/>
            </field>
        </field>
    </record>

    <record id="view_product_template_search_bonuscard" model="ir.ui.view">
        <field name="name">product.template.search.bonuscard</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="inactive" position="after">
                <separator groups="bonuscard_odoo.bonuscard_odoo_group_user"/>
                <filter name="bonuscard_catalog_in" string="Bonuscard: In Catalog" domain="[('bonuscard_catalog_status', '=', 'in_catalog')]" groups="bonuscard_odoo.bonuscard_odoo_group_user"/>
                <filter name="bonuscard_catalog_not_in" string="Bonuscard: Not in Catalog" domain="[('bonuscard_catalog_status', '=', 'not_in_catalog')]" groups="bonuscard_odoo.bonuscard_odoo_group_user"/>
                <filter name="bonuscard_catalog_not_set" string="Bonuscard: Not Set" domain="[('bonuscard_catalog_status', '=', 'not_set')]" groups="bonuscard_odoo.bonuscard_odoo_group_user"/>
            </filter>
        </field>
    </record>

    <record id="view_product_template_form_bonuscard" model="ir.ui.view">
        <field name="name">product.template.form.bonuscard</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']" position="after">
                <page string="Bonuscard" name="bonuscard" groups="bonuscard_odoo.bonuscard_odoo_group_user" invisible="product_variant_count != 1">
                    <group>
                        <field name="bonuscard_catalog_status"/>
                        <field name="bonuscard_catalog_updated_at" readonly="1"/>
                        <field name="bonuscard_catalog_probe_note" groups="bonuscard_odoo.bonuscard_odoo_group_manager"/>
                        <button name="action_bonuscard_probe_catalog_status" string="Check Bonuscard Catalog" type="object" class="btn-secondary" groups="bonuscard_odoo.bonuscard_odoo_group_manager"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Variant form inherits product_template_form_view via
         product_normal_form_view. Reuse the Bonuscard page added above
         instead of inserting a second one; clear the multi-variant hide rule
         so the tab stays visible on Product Variants forms. -->
    <record id="view_product_product_form_bonuscard" model="ir.ui.view">
        <field name="name">product.product.form.bonuscard</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='bonuscard']" position="attributes">
                <attribute name="invisible"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_normalized_pos_bonuscard" model="ir.ui.view">
        <field name="name">product.template.form.normalized.pos.bonuscard</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_view_form_normalized_pos"/>
        <field name="arch" type="xml">
            <field name="color" position="after">
                <field name="product_variant_count" invisible="1"/>
                <field name="bonuscard_catalog_status" string="Bonuscard Catalog" groups="bonuscard_odoo.bonuscard_odoo_group_user" invisible="product_variant_count != 1"/>
            </field>
        </field>
    </record>

    <record id="view_product_template_search_bonuscard_hide_variants" model="ir.ui.view">
        <field name="name">product.template.search.bonuscard.hide.variants</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="bonuscard_odoo.view_product_template_search_bonuscard"/>
        <field name="arch" type="xml">
            <xpath expr="//separator[following-sibling::filter[@name='bonuscard_catalog_in']]" position="attributes" groups="product.group_product_variant">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='bonuscard_catalog_in']" position="attributes" groups="product.group_product_variant">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='bonuscard_catalog_not_in']" position="attributes" groups="product.group_product_variant">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='bonuscard_catalog_not_set']" position="attributes" groups="product.group_product_variant">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
